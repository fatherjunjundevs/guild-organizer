{
  "name": "guild-organizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:sharing": "node scripts/test-share-link-interface-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:test:concurrency": "node scripts/test-share-link-concurrency.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "test:e2e:cleanup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-local-fixture-cleanup.mjs",
    "test:fixtures:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local-fixtures.mjs list",
    "test:fixtures:recover": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/local-fixtures.mjs recover"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "exceljs-hardened": "5.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  }
}
